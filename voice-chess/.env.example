# Copy to `.env` and fill in. Everything here is OPTIONAL — the app runs fully
# offline without it (typed moves, deterministic voice grammar, local engine).
#
# Used for speech-to-text, text-to-speech and natural-language move parsing.
# NOTE: EXPO_PUBLIC_* variables are inlined into the JS bundle and are therefore
# readable by anyone with the app binary. For a shipped product, put the key
# behind your own proxy. For local development this is fine. You can also paste
# a key at runtime in Settings, where it is stored in the device keychain.
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional overrides
# EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1
# EXPO_PUBLIC_STOCKFISH_URL=https://cdn.jsdelivr.net/npm/stockfish.js@10.0.2/stockfish.wasm.js
