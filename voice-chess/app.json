{
  "expo": {
    "name": "Voice Chess",
    "slug": "voice-chess",
    "version": "1.0.0",
    "scheme": "voicechess",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.voicechess.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Voice Chess listens to your spoken moves so you can play hands-free.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "dev.voicechess.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Voice Chess listens to your spoken moves so you can play hands-free."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1116",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
