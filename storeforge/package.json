{
  "name": "storeforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered ecommerce store builder — describe your store, Claude builds it.",
  "scripts": {
    "dev": "node scripts/ensure-sibling-tsconfig.mjs && nuxt dev",
    "build": "node scripts/ensure-sibling-tsconfig.mjs && nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "typecheck": "node scripts/ensure-sibling-tsconfig.mjs && nuxt typecheck",
    "db:reset": "node scripts/reset-db.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "better-sqlite3": "^11.10.0",
    "nuxt": "^3.17.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "typescript": "^5.7.3",
    "vue-tsc": "^2.2.0"
  }
}
