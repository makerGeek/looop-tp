# Required for real AI generation. Without it StoreForge falls back to a
# deterministic local planner so the product is still fully demoable.
ANTHROPIC_API_KEY=

# Override the model if you want to trade cost for latency.
ANTHROPIC_MODEL=claude-opus-5

# Where the SQLite file lives, relative to the project root.
DATABASE_PATH=.data/storeforge.db

# Signs session cookies. Generate one: openssl rand -hex 32
SESSION_SECRET=
