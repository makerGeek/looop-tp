# ─── Required ────────────────────────────────────────────────────────────────

# Postgres. Local development can use the database created by `npm run db:migrate`.
NUXT_DATABASE_URL=postgres://postgres@localhost:5432/storeforge

# Signs session cookies. At least 32 characters: openssl rand -hex 32
NUXT_SESSION_SECRET=

# ─── AI generation ───────────────────────────────────────────────────────────

# Without a key, StoreForge falls back to a deterministic local planner so the
# product stays demoable. With one, Claude builds to your description.
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-opus-5

# ─── Optional integrations ───────────────────────────────────────────────────

# Public base URL, used in emails and Stripe redirects.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (verification, invites, password reset).
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=StoreForge <noreply@storeforge.app>

# Subscription billing — merchants paying StoreForge, not shoppers paying
# merchants. Storefront checkout runs a simulated gateway.
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PRICE_PRO_MONTHLY=
NUXT_STRIPE_PRICE_BUSINESS_MONTHLY=

# Error tracking.
NUXT_SENTRY_DSN=
