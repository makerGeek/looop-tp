# Supabase Edge Functions — local environment
#
# Copy this file to `.env` and fill in the values before running
# `supabase functions serve` locally.
#
# Notes:
#   - `SUPABASE_URL` and `SUPABASE_SERVICE_ROLE_KEY` are auto-injected
#     by the Supabase Edge runtime (both locally via `supabase functions
#     serve` and in production), so you don't need to set them here.
#   - Only secrets you own (like API keys for third-party services)
#     belong in this file.

# Anthropic API key used by the `generate-digest` function to call
# Claude Haiku. Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=
